# Normalize line endings to LF in the repository and in the working tree.
# Required because Prettier uses `endOfLine: "lf"`, so a CRLF checkout on
# Windows makes `pnpm run lint` fail on every line of every file.
* text=auto eol=lf

# Binaries must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
